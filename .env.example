# Server
PORT=5000
NODE_ENV=development
TRUST_PROXY=false

# Database (XAMPP defaults shown)
# On Railway you can reference the MySQL service instead, e.g.
# DATABASE_HOST=${{MySQL.MYSQLHOST}} and DATABASE_NAME=${{MySQL.MYSQLDATABASE}}.
# The server also reads MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD and
# MYSQLDATABASE automatically when the DATABASE_* values are not set.
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=tastehub_kenya

# Security - generate a long random value, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=
JWT_EXPIRES_IN=8h
MIN_PASSWORD_LENGTH=12

# Optional: comma-separated list of allowed browser origins.
# Leave blank when the frontend is served by this same Express app.
CLIENT_ORIGIN=

# Optional one-time administrator seed used by `npm run db:seed`.
# Re-running the seed with a password set resets that administrator's password.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Order limits enforced by the server.
ORDER_MAX_LINE_ITEMS=30
ORDER_MAX_QUANTITY_PER_ITEM=20
ORDER_MAX_TOTAL_ITEMS=100

# Development bootstrap endpoint. Disabled in production unless ALLOW_BOOTSTRAP=true.
ALLOW_BOOTSTRAP=false
BOOTSTRAP_TOKEN=

# Public base URL used in customer delivery confirmation links.
# Leave blank to use http://localhost:<PORT>, or https://$RAILWAY_PUBLIC_DOMAIN
# when deployed on Railway. Set the real domain in production.
PUBLIC_BASE_URL=

# Delivery problem reports are also visible in the HQ message inbox.
# Optionally set an address that should be copied on operational email.
HQ_EMAIL=

# Outgoing email for delivery confirmation and next-delivery messages.
# Leave SMTP_HOST blank to record messages in the email_outbox table without
# sending them (status = logged). Fill these in to send real email.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TasteHub Kenya <orders@tastehub.co.ke>
